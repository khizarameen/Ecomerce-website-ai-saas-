# Copy to .env (or pass with --env-file) when running Docker Compose

# PostgreSQL
POSTGRES_DB=storehub
POSTGRES_USER=storehub
POSTGRES_PASSWORD=storehub_pass

# Django
DEBUG=False
SECRET_KEY=replace-with-strong-random-django-secret
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
INSTALL_CHROMA=false

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Backend AI Keys (Groq + Google AI Studio / Gemini Vision)
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GOOGLE_API_KEY=your-google-ai-studio-key
GEMINI_API_KEY=your-gemini-api-key

# Google OAuth & Stripe
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_STRIPE_PUBLIC_KEY=your-stripe-publishable-key
STRIPE_SECRET_KEY=your-stripe-secret-key
